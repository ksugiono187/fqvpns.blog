---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
const all=(await getCollection('articles',({data})=>data.category==='blog'&&!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title,'zh-CN'));const labels={budget:'费用、流量与账单',stable:'测速、稳定与排错',beginner:'选购与资料核验',ai:'AI平台任务',streaming:'流媒体证据'};
---
<Base title="150篇博客主题目录：费用、测速、排错与资料核验" description="按主题浏览150篇原创博客文章，以具体问题为入口，查找费用计算、测速口径、资料核验、网络排错和平台任务说明。" breadcrumbs={[{name:'博客',url:'/blog/'},{name:'主题目录',url:'/blog/topics/'}]}><div class="container"><div class="page-intro"><span class="eyebrow">150 FIELD NOTES / TOPICS</span><h1>从问题找到文章。</h1><p class="lead">按主题查看完整目录。费用用计算说明，性能用证据说明，遇到异常按步骤排查。</p><p><a class="text-link" href="/blog/">返回分页列表 →</a> · <a class="text-link" href="/research/">公开资料核对 →</a></p></div><nav class="topic-links" aria-label="文章主题">{Object.entries(labels).map(([tag,label])=><a href={`#topic-${tag}`}>{label}</a>)}</nav>{Object.entries(labels).map(([tag,label])=><section id={`topic-${tag}`} class="topic-directory"><h2>{label} <small>{all.filter(e=>e.data.tags.includes(tag)).length}篇</small></h2><ul>{all.filter(e=>e.data.tags.includes(tag)).map(e=><li><a href={`/blog/${e.id}/`}>{e.data.title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>)}</div></Base>
