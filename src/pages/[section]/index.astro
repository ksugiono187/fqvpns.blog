---
import Base from '../../layouts/Base.astro';import ArticleCards from '../../components/ArticleCards.astro';import BrandCard from '../../components/BrandCard.astro';import { getCollection } from 'astro:content';import { topics } from '../../data/site';import { airports } from '../../data/airports';
const hubs={recommend:{title:'机场推荐：按预算与需求选择',description:'用六类需求专题建立候选清单，核验价格、线路与服务限制。'},ranking:{title:'机场与 VPN 排行：依据、范围与数据状态',description:'按可核验的公开资料与同币种费用比较，不使用虚构测速或稳定性评分。'},airport:{title:'品牌资料库：五个 VPN 的官方资料',description:'统一查看官方套餐、限制、来源与最后核验日期，缺失数据标注尚未核实。'},review:{title:'独立评测中心：测试标准与发布进度',description:'说明独立评测需要的环境、原始记录和证据，目前尚未发布实测结论。'},guides:{title:'教程中心：安装、连接与排错',description:'覆盖 Windows、Android、iOS、macOS 和基础排错的使用教程。'},blog:{title:'选择指南：看懂费用、稳定性与适用场景',description:'阅读购买核验、计费周期、稳定性方法、免费方案与平台支持指南。'},glossary:{title:'知识百科：理解常用网络术语',description:'用清楚的解释理解 VPN、代理、流量倍率、DNS、断网保护和分流。'}};
export function getStaticPaths(){return ['recommend','ranking','airport','review','guides','blog','glossary'].map(section=>({params:{section}}));}
const section=Astro.params.section as keyof typeof hubs;const config=hubs[section];const articles=await getCollection('articles',({data})=>!data.draft&&data.category===section);
---
<Base title={config.title} description={config.description} breadcrumbs={[{name:config.title.split('：')[0],url:`/${section}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / {config.title.split('：')[0]}</div><span class="eyebrow">NETWORK FIELD NOTES</span><h1>{config.title}</h1><p class="lead">{config.description}</p></div>{['guides','blog','glossary'].includes(section)&&<ArticleCards entries={articles}/>} {section==='recommend'&&<><div class="notice">首页负责总体选择，本专题按需求拆分。品牌资料以 VPN 为主，代理机场套餐尚未核验。</div><div class="grid-3">{topics.map(t=><a class="card topic" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.icon}</span><h3>{t.name}</h3><p>{t.text}</p></a>)}</div></>}{section==='airport'&&<><label for="brand-filter" class="muted">按品牌名称筛选</label><input id="brand-filter" class="search-input filter-input" type="search" placeholder="例如 Proton"/><p id="filter-status" class="status" aria-live="polite">全部 5 个品牌</p><div class="grid-3" id="brand-cards">{airports.map(a=><div data-brand={a.name.toLowerCase()}><BrandCard airport={a}/></div>)}</div></>}{section==='ranking'&&<><div class="grid-3">{[['overall','综合资料榜','按公开资料覆盖程度排序，完全不涉及测速。'],['budget','低预算榜','同币种月付费用排序；免费方案单独看。'],['value','性价比榜','计算规则已完成，付费定量套餐资料待补充。'],['stable','稳定性榜','无独立测试，暂不发布名次。']].map(([slug,name,text])=><a class="card" href={`/ranking/${slug}/`}><span class="eyebrow">METHODOLOGY</span><h3>{name}</h3><p>{text}</p></a>)}</div><p class="notice">没有一个排序能代替你的网络试用。本站未发布综合性能或稳定性排名。</p></>}{section==='review'&&<article class="prose" style="max-width:800px"><div class="empty">尚无独立实测文章。五份<a href="/airport/">品牌资料</a>已发布，评测模板已准备。</div><h2>实测文章的发布条件</h2><p>记录时间、时区、运营商、设备、客户端版本、节点和目标。保存原始尝试次数与失败记录，再区分官方资料、编辑解释与测试结果。</p><h2>每篇评测覆盖什么</h2><p>包含套餐、节点、客户端、AI 与流媒体测试、优势、限制、适用人群、购买注意、FAQ、比较入口、来源与最后核验日期。缺失实验不得以宣传资料替代。</p><h2>当前证据边界</h2><p>本项目仅核验官方公开网页，没有测速、连接成功率或解锁记录。取得可复现记录后才发布独立结论。阅读<a href="/blog/stability-method/">稳定性观测方法</a>与<a href="/editorial-policy/">编辑政策</a>。</p></article>}</div><script>
const input=document.querySelector<HTMLInputElement>('#brand-filter');input?.addEventListener('input',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-brand]').forEach(card=>{card.hidden=!card.dataset.brand!.includes(input.value.trim().toLowerCase());if(!card.hidden)count++;});document.querySelector('#filter-status')!.textContent=`显示 ${count} 个品牌`;});
</script></Base>
