---
import Base from '../../layouts/Base.astro';import RecommendationHub from '../../components/RecommendationHub.astro';import RankingHub from '../../components/RankingHub.astro';import SuppliedBrandCard from '../../components/SuppliedBrandCard.astro';import {suppliedBrands} from '../../data/supplied-brands';import ArticleCards from '../../components/ArticleCards.astro';import { getCollection } from 'astro:content';
const hubs={recommend:{title:'机场推荐：按预算与需求选择',description:'按预算和月流量筛选29个品牌，查看第三方参考套餐与优惠码，建立适合自己的候选清单。'},ranking:{title:'机场排行：月付价格、用量与单位成本',description:'根据用户指定来源的第三方套餐资料，分别整理低预算月付、200GB需求与标称单位成本参考榜。'},airport:{title:'机场与 VPN 品牌资料库',description:'查看站方提供的 29 个机场品牌入口；推广关系、优惠码和证据状态分开展示。'},review:{title:'独立评测中心：测试标准与发布进度',description:'说明独立评测需要的环境、原始记录和证据，目前尚未发布实测结论。'},guides:{title:'教程中心：安装、连接与排错',description:'覆盖 Windows、Android、iOS、macOS 和基础排错的使用教程。'},blog:{title:'选择指南：看懂费用、稳定性与适用场景',description:'阅读购买核验、计费周期、稳定性方法、免费方案与平台支持指南。'},glossary:{title:'知识百科：理解常用网络术语',description:'用清楚的解释理解 VPN、代理、流量倍率、DNS、断网保护和分流。'}};
export function getStaticPaths(){return ['recommend','ranking','airport','review','guides','blog','glossary'].map(section=>({params:{section}}));}
const section=Astro.params.section as keyof typeof hubs;const config=hubs[section];const articles=await getCollection('articles',({data})=>!data.draft&&data.category===section);
---
<Base title={config.title} description={config.description} breadcrumbs={[{name:config.title.split('：')[0],url:`/${section}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / {config.title.split('：')[0]}</div><span class="eyebrow">NETWORK FIELD NOTES</span><h1>{config.title}</h1><p class="lead">{config.description}</p></div>{['guides','blog','glossary'].includes(section)&&<ArticleCards entries={articles}/>} {section==='recommend'&&<RecommendationHub/>}{section==='airport'&&<><label for="brand-filter" class="muted">按品牌名称筛选</label><input id="brand-filter" class="search-input filter-input" type="search" placeholder="例如 微风网络"/><p id="filter-status" class="status" aria-live="polite">全部 29 个品牌</p><div class="notice">29 个机场品牌由站方提供，套餐尚未核实；推广链接可能带来佣金。<a href="/coupons/">查看全部 11 个优惠码 →</a></div><div class="grid-3" id="brand-cards">{suppliedBrands.map(b=><div data-brand={b.name.toLowerCase()}><SuppliedBrandCard brand={b}/></div>)}</div></>}{section==='ranking'&&<RankingHub/>}{section==='review'&&<article class="prose" style="max-width:800px"><div class="empty">尚无独立实测文章。29 个站方提供的<a href="/airport/">品牌入口</a>已收录，评测模板已准备。</div><h2>实测文章的发布条件</h2><p>记录时间、时区、运营商、设备、客户端版本、节点和目标。保存原始尝试次数与失败记录，再区分官方资料、编辑解释与测试结果。</p><h2>每篇评测覆盖什么</h2><p>包含套餐、节点、客户端、AI 与流媒体测试、优势、限制、适用人群、购买注意、FAQ、比较入口、来源与最后核验日期。缺失实验不得以宣传资料替代。</p><h2>当前证据边界</h2><p>本项目仅核验官方公开网页，没有测速、连接成功率或解锁记录。取得可复现记录后才发布独立结论。阅读<a href="/blog/stability-method/">稳定性观测方法</a>与<a href="/editorial-policy/">编辑政策</a>。</p></article>}</div><script>
const input=document.querySelector<HTMLInputElement>('#brand-filter');input?.addEventListener('input',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-brand]').forEach(card=>{card.hidden=!card.dataset.brand!.includes(input.value.trim().toLowerCase());if(!card.hidden)count++;});document.querySelector('#filter-status')!.textContent=`显示 ${count} 个品牌`;});
</script></Base>
