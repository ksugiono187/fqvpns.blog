---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import ArticleCards from '../../components/ArticleCards.astro';
export async function getStaticPaths(){return (await getCollection('articles',({data})=>!data.draft)).map(entry=>({params:{section:entry.data.category,slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const labels={guides:'教程中心',blog:'选择指南',glossary:'知识百科'};const peers=(await getCollection('articles',({data})=>!data.draft)).filter(e=>e.id!==entry.id&&e.data.tags.some(t=>entry.data.tags.includes(t))).slice(0,3);const category=entry.data.category;const schema=[{'@type':category==='blog'?'BlogPosting':'Article',headline:entry.data.title,description:entry.data.description,datePublished:entry.data.published,dateModified:entry.data.updated,author:{'@type':'Organization',name:'航线观察'},mainEntityOfPage:`https://fqvpns.blog/${category}/${entry.id}/`}];
---
<Base title={entry.data.title} description={entry.data.description} schema={schema} breadcrumbs={[{name:labels[category],url:`/${category}/`},{name:entry.data.title,url:`/${category}/${entry.id}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / <a href={`/${category}/`}>{labels[category]}</a> / 正文</div><span class="eyebrow">{labels[category]}</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="published">航线观察 · 发布 {entry.data.published} · 更新 {entry.data.updated}</p></div><div class="article-shell"><article class="prose"><Content/><h2 id="sources">资料与延伸阅读</h2><ul class="source-list">{entry.data.sources.map((url,i)=><li><a href={url} rel="noopener noreferrer">官方参考 {i+1}：{url}</a></li>)}</ul><p class="muted">本文为原创编辑解释，不构成实测结果。平台版本、政策和可用性请以当前官方资料为准。</p></article><aside class="sidebar"><div class="card"><b>文章目录</b><ul class="toc">{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}<li><a href="#sources">资料来源</a></li></ul></div><div class="card"><b>继续探索</b><a href="/recommend/beginner/">新手选择专题 →</a><a href="/compare/">品牌比较工具 →</a><a href="/editorial-policy/">编辑标准 →</a></div></aside></div><section class="section"><div class="section-head"><h2>相关内容</h2></div><ArticleCards entries={peers}/></section></div></Base>
