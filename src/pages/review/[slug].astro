---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {airports,planPrice,traffic} from '../../data/airports';
export async function getStaticPaths(){return (await getCollection('reviews',({data})=>!data.draft)).map(entry=>{if(!entry.data.evidence.length)throw Error(`Review ${entry.id} needs evidence`);const brand=airports.find(a=>a.slug===entry.data.brand);if(!brand)throw Error(`Unknown brand ${entry.data.brand}`);return {params:{slug:entry.id},props:{entry,brand}};});}
const {entry,brand:a}=Astro.props;const {Content}=await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} breadcrumbs={[{name:'独立评测',url:'/review/'},{name:a.name,url:`/review/${entry.id}/`}]} schema={[{'@type':'Article',headline:entry.data.title,datePublished:entry.data.published,dateModified:entry.data.updated,author:{'@type':'Organization',name:'航线观察'}}]}><div class="container"><div class="page-intro"><span class="eyebrow">INDEPENDENT REVIEW</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.conclusion}</p><p class="published">发布 {entry.data.published} · 更新 {entry.data.updated} · 官方资料核验 {a.lastVerified}</p></div><article class="prose" style="max-width:800px"><h2>品牌基本介绍</h2><p>{a.description}</p><h2>套餐价格表（官方数据）</h2><div class="table-wrap"><table><thead><tr><th>方案</th><th>价格</th><th>流量</th><th>条件</th></tr></thead><tbody>{a.plans.map(p=><tr><td>{p.name}</td><td>{planPrice(p)}</td><td>{traffic(p)}</td><td>{p.note}</td></tr>)}</tbody></table></div><h2>节点与线路资料</h2><p>{a.regions.join('、')||'尚未核实'}；具体线路未经此字段证明。</p><h2>客户端与设备</h2><p>{a.deviceLimit||'尚未核实'}；各系统版本以官方文档为准。</p><h2>AI 与流媒体支持</h2><p>以下正文须逐项说明具体平台与测试日期，缺少记录的项目保持尚未核实。</p><Content/><h2>原始测试证据</h2><ul>{entry.data.evidence.map(url=><li><a href={url}>{url}</a></li>)}</ul><h2>相关比较</h2><p><a href={`/compare/?brands=${a.slug}`}>加入比较工具</a> · <a href={`/airport/${a.slug}/`}>查看公开品牌资料</a></p><h2>数据来源</h2><ul>{[...new Set([...a.sources,...entry.data.sources])].map(url=><li><a href={url}>{url}</a></li>)}</ul></article></div></Base>
