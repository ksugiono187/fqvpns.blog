---
import Base from '../../layouts/Base.astro';import SuppliedProfile from '../../components/SuppliedProfile.astro';import {suppliedBrands} from '../../data/supplied-brands';import {airports,planPrice,traffic,costPerGB} from '../../data/airports';
export function getStaticPaths(){return [...airports.map(a=>({params:{slug:a.slug},props:{airport:a}})),...suppliedBrands.map(b=>({params:{slug:b.slug},props:{supplied:b}}))];}const supplied=Astro.props.supplied;const a=Astro.props.airport!;
---
{supplied ? <SuppliedProfile brand={supplied}/> : <Base title={`${a.name} 资料：套餐价格、限制与来源`} description={`${a.description} 本页核验官方定价与功能说明，列出尚未核实的数据；不包含本站测速或解锁测试。`} breadcrumbs={[{name:'品牌资料',url:'/airport/'},{name:a.name,url:`/airport/${a.slug}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / <a href="/airport/">品牌资料</a> / {a.name}</div><span class="eyebrow">品牌档案 / VPN</span><h1>{a.name}：套餐与公开资料</h1><p class="lead">{a.description}</p><p class="published">最后核验：{a.lastVerified} · 来源：官方公开资料 · 未实测</p></div><div class="article-shell"><article class="prose"><div class="notice">这是 VPN 品牌资料页。本站没有进行连接、速度、稳定性、AI 或流媒体测试。该服务不作为已核实的代理机场专线。</div><h2>一句话结论</h2><p>{a.suitableFor.join('、')}用户可以将它加入资料初筛；购买决定仍需你自己的网络试用。</p><h2>套餐价格</h2><div class="table-wrap"><table><thead><tr><th>方案</th><th>价格 / 周期</th><th>流量</th><th>每 GB 成本</th><th>条件</th></tr></thead><tbody>{a.plans.map(p=><tr><td>{p.name}</td><td>{planPrice(p)}</td><td>{traffic(p)}</td><td>{costPerGB(p)===undefined?'不适用 / 尚未核实':`${costPerGB(p)!.toFixed(3)} ${p.currency}`}</td><td>{p.note}</td></tr>)}</tbody></table></div><h2>节点与线路资料</h2><p>地区列表：{a.regions.length?a.regions.join('、'):'尚未核实'}。专线、入口与跨境线路：尚未核实。协议：{a.protocols.length?a.protocols.join('、')+'（官方资料）':'尚未核实'}。</p><h2>客户端与设备</h2><p>设备限制：{a.deviceLimit??'尚未核实'}。请通过品牌官方入口下载适合你的系统的客户端，具体版本与兼容要求以其文档为准。</p><p>可参考<a href="/guides/windows/">Windows 入门</a>、<a href="/guides/android/">Android 入门</a>、<a href="/guides/ios/">iOS 入门</a>与<a href="/guides/macos/">macOS 入门</a>。</p><h2>AI 与流媒体</h2><p>AI 实测：尚未核实。流媒体实测：尚未核实。官方宣传、支持列表与本站独立测试是不同证据类型；本页不提供解锁承诺。</p><h2>公开资料中的优势</h2><ul>{a.advantages.map(x=><li>{x}</li>)}</ul><h2>已知限制与信息缺口</h2><ul>{a.disadvantages.map(x=><li>{x}</li>)}</ul><h2>适合人群</h2><p>{a.suitableFor.join('、')}。如果你的核心需求是特定入口、地区或 AI 平台，请先向品牌确认支持条件并短期验证。</p><h2>购买前注意事项</h2><p>核对付款币种、税费、周期、自动续费和退款规则。不要把年付折算月价理解成随时可取消的月付。可用性取决于实际网络，官方价格核验不包含本地连通性验证。</p><h2>常见问题</h2><h3>这些价格来自哪里？</h3><p>来自本页列出的官方网页，核验日期为 {a.lastVerified}；结账页可能因税费或调整而变化。</p><h3>有独立测速吗？</h3><p>尚无。完成测试后将以独立评测发布环境、时间和可复现记录。</p><h2>横向比较</h2><p><a href={`/compare/?brands=${a.slug}`}>将 {a.name} 加入比较</a>，再选择其他品牌，按相同口径查看差异。</p><h2>数据来源</h2><ul class="source-list">{a.sources.map(url=><li><a href={url} rel="noopener noreferrer">{url}</a></li>)}</ul></article><aside class="sidebar"><div class="card"><b>资料状态</b><p>官方数据核验</p><p>编辑整理：已完成</p><p>实际测试：未进行</p><a href="/editorial-policy/">如何判断证据 →</a></div><div class="card"><b>相关品牌</b>{airports.filter(x=>x.id!==a.id).slice(0,3).map(x=><a href={`/airport/${x.slug}/`}>{x.name} →</a>)}</div></aside></div></div></Base>}
