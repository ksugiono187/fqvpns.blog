---
import Base from '../../layouts/Base.astro';import {suppliedBrands} from '../../data/supplied-brands';
export function getStaticPaths(){return ['overall','budget','value','stable'].map(slug=>({params:{slug}}));}
const slug=Astro.params.slug!;
const methods={overall:{title:'综合资料榜：核验范围与数据状态',summary:'当前仅收录站方提供的品牌入口与优惠码，尚无足够套餐资料，不发布综合名次。',rule:'分别核对价格、流量、设备限制与协议，并附原始来源。资料完整程度不等于性能、隐私或服务质量。'},budget:{title:'低预算价格榜：比较口径与数据状态',summary:'29 个品牌的套餐价格尚未核实，暂不发布价格序位。可先查看现有优惠码。',rule:'只有已核验的月付方案才能按同币种比较。免费、年付折算价和一次付费分开展示；未核验价格不参与排序。'},value:{title:'性价比榜：每 GB 成本与排序规则',summary:'尚无可核验的付费定量套餐，不发布每 GB 性价比名次。',rule:'每 GB 单价 = 套餐价格 ÷（标注流量 ÷ 倍率）。仅比较同币种、同周期、已核验的有限流量付费套餐。不限流量不计算每 GB 成本。'},stable:{title:'稳定性榜：测试方法与数据状态',summary:'尚无独立测试记录，不发布稳定性分数或名次。',rule:'固定运营商、客户端、设备、节点和目标，覆盖多个时段，公开连接成功率、延迟、丢包与失败记录。结论须限定日期与环境。'}};
const method=methods[slug as keyof typeof methods];
---
<Base title={method.title} description={method.summary} noindex={slug==='stable'} breadcrumbs={[{name:'机场排行',url:'/ranking/'},{name:method.title.split('：')[0],url:`/ranking/${slug}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / <a href="/ranking/">机场排行</a> / {method.title.split('：')[0]}</div><span class="eyebrow">TRANSPARENT RANKING</span><h1>{method.title}</h1><p class="lead">{method.summary}</p></div><article class="prose"><h2>比较依据</h2><p>{method.rule}</p><div class="notice">品牌按站方提供顺序收录，顺序不代表名次。优惠码不作为价格、质量或性能评分依据。</div><h2>目前可以查看什么？</h2><p><a href="/airport/">29 个品牌入口</a>、<a href="/coupons/">11 个优惠码</a>与<a href="/compare/">横向比较工具</a>。套餐与线路字段待取得来源后补充。</p><h2>品牌资料入口</h2><ul>{suppliedBrands.map(b=><li><a href={`/airport/${b.slug}/`}>{b.name}</a> · 站方提供，套餐待核实</li>)}</ul><p>测试记录要求见<a href="/blog/stability-method/">稳定性观测方法</a>，排序政策见<a href="/editorial-policy/">编辑政策</a>。</p></article></div></Base>
