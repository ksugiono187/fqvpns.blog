---
import Base from '../../layouts/Base.astro';import RankingBoard from '../../components/RankingBoard.astro';
export function getStaticPaths(){return ['overall','budget','value','stable'].map(slug=>({params:{slug}}));}
const slug=Astro.params.slug!;
const methods={overall:{title:'200GB 需求参考榜：满足用量的最低月支出',summary:'固定每月至少200GB需求，每个品牌选择满足容量的最低参考月付档，按支付金额排序。',rule:'只使用月付、月流量明确且容量不少于200GB的参考档。同一品牌只保留最低支出档；容量归属有分歧的套餐排除。'},budget:{title:'低预算机场排行：参考月付价格榜',summary:'按各品牌最低参考月付金额排列，不将年付折合月价或一次性包混入月付排行。',rule:'人民币月付金额升序，同价并列。每个品牌只取最低月付档，容量不同，不能据此判断单位成本或使用表现。'},value:{title:'机场标称单位成本榜：月付元每GB比较',summary:'各品牌选择标称元每GB最低的明确月付档，比较容量成本，同时展示实际月支出。',rule:'标称元/GB = 月付金额 ÷ 标称月流量。排除流量不明、一次性、年付和归属争议档。不计节点倍率与优惠，未使用流量不会降低订单金额。'},stable:{title:'稳定性排行：测试条件与证据进度',summary:'尚无本站独立测试，不发布速度、成功率或稳定性名次。可先按预算与容量建立候选。',rule:'稳定性结论需要固定设备、运营商、客户端、节点和目标，多时段记录连接成功率、延迟、丢包和失败情况。第三方套餐资料无法替代这些记录。'}};
const method=methods[slug as keyof typeof methods];
---
<Base title={method.title} description={method.summary} noindex={slug==='stable'} breadcrumbs={[{name:'机场排行',url:'/ranking/'},{name:method.title.split('：')[0],url:`/ranking/${slug}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / <a href="/ranking/">机场排行</a> / {method.title.split('：')[0]}</div><span class="eyebrow">ONE METRIC / ONE CLEAR RULE</span><h1>{method.title}</h1><p class="lead">{method.summary}</p></div><nav class="ranking-tabs" aria-label="排行榜分类">{[['budget','月付价格'],['overall','200GB 需求'],['value','标称单位成本'],['stable','稳定性进度']].map(([id,name])=><a href={`/ranking/${id}/`} aria-current={slug===id?'page':undefined}>{name} ↗</a>)}</nav><div class="notice"><b>本表口径：</b>{method.rule}<br/>金额与容量来自 <a href="https://jichangblog.org/compare/" target="_blank" rel="noopener noreferrer">jichangblog.org</a>，来源记录 2026.10.03，本站导入 2026.10.12。第三方参考不等于当前官网售价；本站未独立测速。</div>{slug==='stable'?<section class="prose"><h2>目前尚缺哪些证据？</h2><p>没有本站原始连接记录、节点测试条件、失败样本和连续时段数据，因此不制造稳定性评分。</p><p><a href="/research/">已整理29个品牌的公开资料与检索状态 →</a>。第三方记录环境不同，尚未独立确认，不生成跨品牌速度或稳定性评分。</p><h2>仍然可以怎样选择？</h2><p>先用<a href="/recommend/">预算与用量筛选</a>找到容量合适的参考档，再通过<a href="/compare/">比较工具</a>建立候选。测试方法见<a href="/blog/stability-method/">稳定性观测指南</a>。</p></section>:<RankingBoard kind={slug}/>}<section class="selection-steps"><a href="/recommend/"><span>01</span><h3>按用量筛选</h3><p>预算与流量应由同一个套餐满足。</p></a><a href="/compare/"><span>02</span><h3>同时比较候选</h3><p>核对价格、容量和计费条件。</p></a><a href="/coupons/"><span>03</span><h3>确认优惠是否生效</h3><p>优惠不预先计入参考排行。</p></a></section></div></Base>
