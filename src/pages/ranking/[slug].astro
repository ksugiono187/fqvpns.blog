---
import Base from '../../layouts/Base.astro';import {airports,pricedMonthly,planPrice,traffic,costPerGB} from '../../data/airports';
export function getStaticPaths(){return ['overall','budget','value','stable'].map(slug=>({params:{slug}}));}
const slug=Astro.params.slug!;const title={overall:'综合资料榜：按公开信息覆盖程度排序',budget:'低预算价格榜：同币种月付费用比较',value:'性价比榜：每 GB 成本与排序规则',stable:'稳定性榜：测试方法与数据状态'}[slug]!;
const coverage=(a:typeof airports[number])=>[a.plans.some(p=>p.verified),a.plans.some(p=>p.verified&&(p.unlimited||p.trafficGB)),!!a.deviceLimit,a.protocols.length>0].filter(Boolean).length;
const overall=[...airports].sort((a,b)=>coverage(b)-coverage(a)||a.name.localeCompare(b.name));const eligible=airports.flatMap(a=>a.plans.filter(p=>p.period==='month'&&p.price>0&&costPerGB(p)!==undefined).map(p=>({a,p})));
const listSchema=slug==='overall'?[{'@type':'ItemList',name:title,itemListElement:overall.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://fqvpns.blog/airport/${a.slug}/`}))}]:[];
---
<Base title={title} description={slug==='overall'?'按价格、流量规则、设备限制和协议四项资料覆盖排序，展示已核实字段与来源；本榜不衡量网络性能。':slug==='stable'?'本站尚无稳定性实测，公开测试条件与记录要求，暂不发布品牌名次。':slug==='value'?'明确每 GB 成本计算、流量倍率和分组口径，未核实或不限流量方案不参与排序。':'根据可核验的官方数据比较方案，公开排序口径、来源与信息缺口，不使用虚构测速。'} noindex={slug==='stable'} schema={listSchema} breadcrumbs={[{name:'机场排行',url:'/ranking/'},{name:title.split('：')[0],url:`/ranking/${slug}/`}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / <a href="/ranking/">机场排行</a> / {title.split('：')[0]}</div><span class="eyebrow">TRANSPARENT RANKING</span><h1>{title}</h1><p class="published">数据核验：2026-10-12 · 全部来自官方公开资料</p></div><article class="prose"><h2>快速结论</h2><p>{slug==='overall'?'本榜只反映资料库中可确认字段的覆盖程度，不能解释为综合性能、隐私或服务质量排名。':slug==='budget'?'按月控制支出时，先比较同币种的实际月付价格；免费与年付另外展示。价格序位不代表质量。':slug==='value'?'当前没有已核验的付费定量月付方案，因此不发布每 GB 性价比名次。免费方案与不限流量方案不混入付费排序。':'没有多时段原始测试记录，就没有可信的稳定性排名。本站暂不发布任何稳定性分数或名次。'}</p><h2>排名依据与边界</h2><p>{slug==='overall'?'四个字段各计一项：已核验价格、已知流量规则、已知设备限制、已知协议。总计 0–4 项，同分按品牌名称排列。未知字段并不意味着品牌没有该功能；资料覆盖不是性能评分。':slug==='budget'?'只对已核验的月付方案排序，按币种分组；不转换汇率，不纳入年付折算价、免费方案或未核实的方案。':slug==='value'?'每 GB 单价 = 套餐价格 ÷（标注流量 ÷ 倍率）。只排序同币种、同周期、已核验且具有有限流量的付费月付方案。不限流量单价为不适用，缺失流量为尚未核实。':'测试须固定运营商、客户端、设备、节点和目标，并覆盖多个常用时段。公开连接成功次数、总尝试次数、延迟、丢包与失败记录；测试结论须限定日期与环境。'}</p></article>{slug==='overall'&&<div class="table-wrap"><table><thead><tr><th>资料序位</th><th>品牌</th><th>已核验字段</th><th>首个方案</th><th>适合初筛人群</th></tr></thead><tbody>{overall.map((a,i)=><tr><td>{i&&coverage(a)===coverage(overall[i-1])?'并列':i+1}</td><td><a href={`/airport/${a.slug}/`}>{a.name}</a></td><td>{coverage(a)} / 4</td><td>{planPrice(a.plans[0])}</td><td>{a.suitableFor.join('、')}</td></tr>)}</tbody></table></div>}{slug==='budget'&&['USD','EUR'].map(currency=><section class="section"><div class="section-head"><h2>{currency} 月付价格</h2></div><div class="table-wrap"><table><thead><tr><th>价格序位</th><th>品牌</th><th>方案</th><th>价格</th><th>流量</th></tr></thead><tbody>{pricedMonthly(currency).map(({a,p},i)=><tr><td>{i+1}</td><td><a href={`/airport/${a.slug}/`}>{a.name}</a></td><td>{p.name}</td><td>{planPrice(p)}</td><td>{traffic(p)}</td></tr>)}</tbody></table></div></section>)}{slug==='value'&&<div class="empty">付费定量方案符合条件数量：{eligible.length}。待取得可核验流量、周期与倍率资料后启用排序。现阶段可参考<a class="text-link" href="/ranking/budget/">月付费用比较</a>。</div>}{slug==='stable'&&<div class="empty">尚无独立测试记录，此页暂设 noindex 并从 Sitemap 排除。方法详见<a class="text-link" href="/blog/stability-method/">稳定性观测指南</a>。</div>}<section class="section prose"><h2>品牌资料、来源与评测</h2><p>所有品牌当前仅有公开资料，尚未发布独立评测。以下链接分别展示套餐、适合人群和原始来源。</p><ul>{airports.map(a=><li><a href={`/airport/${a.slug}/`}>{a.name} 资料</a> · {a.sources.map((s,i)=><a href={s}>官方来源 {i+1} </a>)}</li>)}</ul><p><a href="/compare/">打开横向比较工具</a>，或阅读<a href="/editorial-policy/">编辑与排行政策</a>。</p></section></div></Base>
