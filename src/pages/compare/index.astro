---
import Base from '../../layouts/Base.astro';import {catalog as airports,monthlyStart,unitPrice} from '../../data/selection';
const payload=airports.map(a=>{const p=monthlyStart(a);return {slug:a.slug,name:a.name,coupon:a.coupon??'暂未提供',price:p?`¥${p.price} CNY / 月（参考）`:'尚未核实',traffic:p?.trafficPeriod==='month'&&p.trafficGB?`${p.trafficGB}GB/月`:'尚未核实',cost:p&&unitPrice(p)!==undefined?`¥${unitPrice(p)!.toFixed(3)} / GB（标称）`:'不计算',regions:'尚未核实',protocols:'尚未核实',devices:'尚未核实',ai:'尚未核实',streaming:'尚未核实',advantages:'未取得独立测试',disadvantages:a.note};});
---
<Base title="机场品牌比较工具：选择 2–4 个候选" description="比较站方提供的品牌与优惠码，月付金额与流量来自第三方参考，协议与限制待核实。选择或移除 2–4 个品牌，所有数据来自统一资料库，缺失信息明确显示尚未核实。" breadcrumbs={[{name:'机场对比',url:'/compare/'}]}><div class="container"><div class="page-intro"><div class="breadcrumbs"><a href="/">首页</a> / 品牌比较</div><span class="eyebrow">SIDE BY SIDE</span><h1>把候选方案，放在一起比较</h1><p class="lead">选择 2–4 个品牌。金额与流量采用各品牌最低参考月付档，容量不同；来源为 jichangblog.org，当前售价、倍率与使用表现需另行确认。</p></div><fieldset class="card"><legend>添加或移除候选品牌</legend><div class="compare-picker">{airports.map(a=><label class="compare-choice"><input type="checkbox" name="brand" value={a.slug}/>{a.name}</label>)}</div><button class="button" id="clear-compare">清空选择</button></fieldset><p class="status" id="compare-status" aria-live="polite">尚未选择品牌；请添加 2–4 个候选。</p><div id="compare-output" class="empty">选择至少两个品牌后显示比较表。</div><noscript><p class="notice">交互比较需要启用 JavaScript。下方完整资料仍可直接阅读。</p></noscript><section class="section"><div class="section-head"><h2>全部品牌概览</h2></div><div class="table-wrap"><table><thead><tr><th>品牌</th><th>优惠码</th><th>流量</th><th>资料页</th></tr></thead><tbody>{payload.map(a=><tr><td>{a.name}</td><td>{a.coupon}</td><td>{a.traffic}</td><td><a href={`/airport/${a.slug}/`}>查看详情</a></td></tr>)}</tbody></table></div><p class="muted">不限流量不计算每 GB 成本；币种不转换。AI、流媒体和稳定性尚无本站实测。</p></section><script id="compare-data" type="application/json" set:html={JSON.stringify(payload).replace(/</g,'\u003c')}/></div><script>
type Entry={slug:string;name:string;[key:string]:string};const data:Entry[]=JSON.parse(document.querySelector('#compare-data')!.textContent!);const checks=Array.from(document.querySelectorAll<HTMLInputElement>('input[name=brand]'));const fields=[['coupon','优惠码（有效性待核实）'],['price','价格 / 周期'],['traffic','流量'],['cost','每 GB 成本'],['regions','节点地区'],['protocols','协议'],['devices','设备限制'],['ai','AI 支持（实测）'],['streaming','流媒体（实测）'],['advantages','公开资料优势'],['disadvantages','限制与缺口']];
const params=new URLSearchParams(location.search);const preset=(params.get('brands')??'').split(',').filter(x=>data.some(a=>a.slug===x)).slice(0,4);checks.forEach(c=>c.checked=preset.includes(c.value));
function render(){const selected=checks.filter(c=>c.checked);checks.forEach(c=>{c.disabled=selected.length>=4&&!c.checked;});const status=document.querySelector('#compare-status')!;const out=document.querySelector('#compare-output')!;status.textContent=`已选择 ${selected.length} / 4 个品牌${selected.length<2?'；至少选择两个品牌。':'；取消勾选即可移除。'}`;out.replaceChildren();out.className=selected.length<2?'empty':'table-wrap';const url=new URL(location.href);if(selected.length)url.searchParams.set('brands',selected.map(c=>c.value).join(','));else url.searchParams.delete('brands');history.replaceState(null,'',url);if(selected.length<2){out.textContent='选择至少两个品牌后显示比较表。';return;}const entries=selected.map(c=>data.find(a=>a.slug===c.value)!);const table=document.createElement('table');const caption=document.createElement('caption');caption.className='muted';caption.textContent='站方提供的品牌资料比较 · 套餐和优惠条件待核实';table.append(caption);const head=document.createElement('thead');const hr=document.createElement('tr');for(const text of ['比较维度',...entries.map(a=>a.name)]){const th=document.createElement('th');th.scope='col';th.textContent=text;hr.append(th);}head.append(hr);table.append(head);const body=document.createElement('tbody');for(const [key,label]of fields){const tr=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;tr.append(th);for(const a of entries){const td=document.createElement('td');td.textContent=a[key];tr.append(td);}body.append(tr);}table.append(body);out.append(table);}checks.forEach(c=>c.addEventListener('change',render));document.querySelector('#clear-compare')!.addEventListener('click',()=>{checks.forEach(c=>c.checked=false);render();});render();
</script></Base>
