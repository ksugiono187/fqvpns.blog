---
import '../styles/global.css';
import '../styles/premium.css';
import '../styles/orbit.css';
import '../styles/coupons.css';
import '../styles/selection.css';
import { site } from '../data/site';
interface Props { title: string; description: string; noindex?: boolean; breadcrumbs?: {name:string;url:string}[]; schema?: Record<string,unknown>[] }
const {title,description,noindex=false,breadcrumbs=[],schema=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.domain).href;
const nav=[['首页','/'],['优惠码','/coupons/'],['机场推荐','/recommend/'],['机场排行','/ranking/'],['机场评测','/review/'],['机场对比','/compare/'],['使用教程','/guides/'],['博客','/blog/']];
const structured=[{'@type':'Organization','@id':site.domain+'/#organization',name:site.name,url:site.domain+'/'},{'@type':'WebSite',name:site.name,url:site.domain+'/',inLanguage:'zh-CN'},...(breadcrumbs.length?[{'@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.domain).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · 航线观察</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta property="og:type" content={schema.some(s=>s['@type']==='BlogPosting')?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content={site.name}/><meta property="og:image" content={site.domain+'/social.svg'}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{import.meta.env.BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.BING_SITE_VERIFICATION}/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':structured}).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">跳转到正文</a><header><div class="container topbar"><a class="brand" href="/" aria-label="航线观察 NETWORK FIELD NOTES 首页"><span class="brand-symbol" aria-hidden="true">↗</span><span>航线观察<small>NETWORK FIELD NOTES</small></span></a><nav class="desktop-nav" aria-label="主导航">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><button class="icon-button" data-open-search aria-label="搜索内容">⌕</button><button class="icon-button mobile-menu" data-menu aria-label="展开导航" aria-expanded="false" aria-controls="mobile-nav">☰</button></div></div><nav id="mobile-nav" class="mobile-nav" aria-label="移动导航" hidden>{nav.map(([label,url])=><a href={url}>{label}</a>)}</nav></header><main id="main"><slot/></main><footer><div class="container"><div class="footer-grid"><div><a class="brand" href="/">航线观察</a><p>把复杂的网络选择，变成清楚的判断。整理公开资料，说明证据边界，持续记录有用的变化。</p></div><div><b class="muted">探索内容</b><div class="footer-links">{[...nav.slice(1),['知识百科','/glossary/']].map(([label,url])=><a href={url}>{label}</a>)}</div></div><div><b class="muted">透明与信任</b><div class="footer-links">{[['关于我们','/about/'],['联系方式','/contact/'],['编辑政策','/editorial-policy/'],['隐私政策','/privacy-policy/'],['免责声明','/disclaimer/'],['Sitemap','/sitemap-index.xml']].map(([label,url])=><a href={url}>{label}</a>)}</div></div></div><div class="footer-bottom"><span>© 2026 航线观察 · fqvpns.blog</span><span>公开资料 ≠ 实测结果 · 不承诺服务可用性</span></div></div></footer><dialog id="search-dialog" aria-labelledby="search-title"><div class="dialog-head"><h2 id="search-title">搜索航线观察</h2><button class="icon-button" data-close-search aria-label="关闭搜索">×</button></div><label for="site-search" class="muted">输入品牌、教程或知识关键词</label><input id="site-search" class="search-input" type="search" autocomplete="off"/><p id="search-status" class="status" aria-live="polite">输入关键词开始搜索</p><ul id="search-results"></ul></dialog><script>
const menu=document.querySelector<HTMLButtonElement>('[data-menu]'); menu?.addEventListener('click',()=>{const n=document.querySelector<HTMLElement>('#mobile-nav')!;n.hidden=!n.hidden;menu.setAttribute('aria-expanded',String(!n.hidden));});
const dialog=document.querySelector<HTMLDialogElement>('#search-dialog')!;document.querySelector('[data-open-search]')?.addEventListener('click',()=>{dialog.showModal();document.querySelector<HTMLInputElement>('#site-search')?.focus();});document.querySelector('[data-close-search]')?.addEventListener('click',()=>dialog.close());
let index: {title:string;description:string;url:string}[]|undefined;let generation=0;document.querySelector('#site-search')?.addEventListener('input',async event=>{const request=++generation;const q=(event.target as HTMLInputElement).value.trim().toLocaleLowerCase();const list=document.querySelector('#search-results')!;const status=document.querySelector('#search-status')!;list.replaceChildren();if(!q){status.textContent='输入关键词开始搜索';return;}try{index??=await fetch('/search-index.json').then(r=>{if(!r.ok)throw Error();return r.json()});if(request!==generation)return;const matches=index!.filter(x=>(x.title+' '+x.description).toLowerCase().includes(q)).slice(0,20);status.textContent=`找到 ${matches.length} 条内容`;for(const item of matches){const li=document.createElement('li');const a=document.createElement('a');a.href=item.url;a.className='search-result';a.textContent=item.title;const small=document.createElement('small');small.textContent=item.description;a.append(small);li.append(a);list.append(li);}}catch{status.textContent='搜索暂时不可用，请通过导航浏览内容。';}});
</script></body></html>
