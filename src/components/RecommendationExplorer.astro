---
import {catalog,monthlyStart} from '../data/selection';import SuppliedBrandCard from './SuppliedBrandCard.astro';
const {initial='all'}=Astro.props;
const payload=catalog.map(b=>({slug:b.slug,name:b.name,coupon:!!b.coupon,monthly:monthlyStart(b)?.price,plans:b.plans.filter(p=>p.period==='month').map(p=>({price:p.price,gb:p.trafficGB,capacityEligible:p.trafficPeriod==='month'&&!(b.slug==='v2yun'&&p.name.includes('至尊'))})),once:b.plans.some(p=>p.period==='one-time')}));
---
<section class="selection-explorer" aria-label="按预算和用量筛选品牌"><div class="selection-controls"><label>品牌名称<input type="search" id="recommend-search" placeholder="搜索品牌，如 微风"/></label><label>最高月预算<select id="recommend-budget"><option value="0">不限预算</option><option value="20" selected={initial==='budget'}>20 元以内</option><option value="30">30 元以内</option><option value="50">50 元以内</option><option value="100">100 元以内</option><option value="200">200 元以内</option></select></label><label>每月流量需求<select id="recommend-traffic"><option value="0">不限流量需求</option><option value="50">至少 50GB</option><option value="150">至少 150GB</option><option value="200">至少 200GB</option><option value="500" selected={initial==='traffic'}>至少 500GB</option><option value="1000">至少 1000GB</option></select></label><label>套餐条件<select id="recommend-type"><option value="all">全部品牌</option><option value="coupon">有优惠码</option><option value="once" selected={initial==='once'}>有一次性包</option></select></label><button class="button" id="reset-recommend">重置</button></div><p class="status" id="recommend-status" aria-live="polite">共 29 个品牌</p><p class="muted">预算与流量必须由同一个月付套餐同时满足；筛选未计优惠、倍率或附加费。无条件时保留全部品牌。</p><div class="grid-3" id="recommend-cards">{catalog.map(b=><div data-candidate={b.slug}><SuppliedBrandCard brand={b}/><p class="match-plan" data-match={b.slug}>{monthlyStart(b)?`参考月付 ¥${monthlyStart(b)!.price} 起`:'金额待核实'}</p></div>)}</div><div class="empty" id="recommend-empty" hidden>没有同时符合条件的参考套餐。试着提高预算、降低流量需求，或清除套餐条件。</div><script type="application/json" id="recommend-data" set:html={JSON.stringify(payload).replace(/</g,'\u003c')}/></section>
<script>
type Entry={slug:string;name:string;coupon:boolean;monthly?:number;plans:{price:number;gb:number|null;capacityEligible:boolean}[];once:boolean};const items:Entry[]=JSON.parse(document.querySelector('#recommend-data')!.textContent!);const search=document.querySelector<HTMLInputElement>('#recommend-search')!;const budget=document.querySelector<HTMLSelectElement>('#recommend-budget')!;const traffic=document.querySelector<HTMLSelectElement>('#recommend-traffic')!;const type=document.querySelector<HTMLSelectElement>('#recommend-type')!;
function update(){let count=0;for(const b of items){const max=Number(budget.value)||Infinity;const need=Number(traffic.value);const hasLimits=!!Number(budget.value)||!!need;const p=[...b.plans].sort((a,c)=>a.price-c.price).find(p=>p.price<=max&&(!need||(p.capacityEligible&&p.gb!==null&&p.gb>=need)));const match=b.name.toLowerCase().includes(search.value.trim().toLowerCase())&&(!hasLimits||!!p)&&(type.value!=='coupon'||b.coupon)&&(type.value!=='once'||b.once);document.querySelector<HTMLElement>(`[data-candidate="${b.slug}"]`)!.hidden=!match;if(match)count++;document.querySelector(`[data-match="${b.slug}"]`)!.textContent=hasLimits&&p?`满足条件的月付档：¥${p.price} / ${p.capacityEligible&&p.gb?p.gb+'GB':'流量待核实'}` :b.monthly?`参考月付 ¥${b.monthly} 起`:'金额待核实';}document.querySelector('#recommend-status')!.textContent=`显示 ${count} / ${items.length} 个品牌`;document.querySelector<HTMLElement>('#recommend-empty')!.hidden=count!==0;}
[search,budget,traffic,type].forEach(el=>el.addEventListener('input',update));document.querySelector('#reset-recommend')!.addEventListener('click',()=>{search.value='';budget.value='0';traffic.value='0';type.value='all';update();});update();
</script>
