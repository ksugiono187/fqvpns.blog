---
import CouponCode from './CouponCode.astro';
import {referenceRank,unitPrice,catalog} from '../data/selection';
const {kind='budget'}=Astro.props;const rows=referenceRank(kind);const excluded=catalog.filter(b=>!rows.some(r=>r.b.slug===b.slug));
---
<div class="rank-toolbar"><label for="rank-search">搜索榜内品牌</label><input class="search-input" type="search" id="rank-search" placeholder="输入品牌名称"/><span class="status" id="rank-count" aria-live="polite">{rows.length} 个参考候选</span></div><div class="table-wrap"><table class="reference-ranking"><caption>{kind==='overall'?'满足至少 200GB/月的最低支出':kind==='value'?'各品牌最低标称元/GB月付档':'各品牌最低参考月付档'} · CNY · 未计优惠</caption><thead><tr><th scope="col">参考序位</th><th scope="col">品牌 / 套餐</th><th scope="col">月付金额</th><th scope="col">月流量</th><th scope="col">标称元/GB</th><th scope="col">优惠码</th><th scope="col">操作</th></tr></thead><tbody>{rows.map(r=><tr data-rank-brand={r.b.name.toLowerCase()} data-price={r.p.price} data-slug={r.b.slug}><td><span class="rank-number">{rows.filter(x=>Math.abs(x.value-r.value)<1e-9).length>1?'并列 ':''}{r.rank}</span></td><td><a href={`/airport/${r.b.slug}/`}>{r.b.name}</a><small>{r.p.name}</small></td><td><strong>¥{r.p.price}</strong><small>实际月付</small></td><td>{r.p.trafficPeriod==='month'&&r.p.trafficGB?`${r.p.trafficGB} GB`:'待核实'}</td><td>{unitPrice(r.p)!==undefined?`¥${unitPrice(r.p)!.toFixed(3)}`:'不计算'}</td><td>{r.b.coupon?<CouponCode code={r.b.coupon} brand={r.b.name}/>:'暂未提供'}</td><td><button type="button" class="rank-select" data-select-brand aria-pressed="false">加入比较 +</button><a href={r.b.sourceUrl} target="_blank" rel="noopener noreferrer">资料来源 ↗</a></td></tr>)}</tbody></table></div><p class="muted">序位仅表示本表指标大小；同值并列，不代表速度、稳定性、隐私或服务质量。元/GB 按标称容量计算，倍率待确认。</p>{excluded.length>0&&<details class="rank-exclusions"><summary>未进入本表的 {excluded.length} 个品牌与原因</summary><ul>{excluded.map(b=><li><a href={`/airport/${b.slug}/`}>{b.name}</a>：{b.status==='disputed'?'套餐归属存在疑点':b.status==='missing'?'指定来源未收录':kind==='overall'?'缺少符合 200GB 需求的明确月付档':'没有符合本表规则的套餐'}</li>)}</ul></details>}
<div class="rank-budget" role="group" aria-label="月付预算快捷筛选"><span>月付预算</span>{[0,20,30,50,100].map(n=><button type="button" data-budget={n} aria-pressed={n===0?'true':'false'}>{n?`≤ ¥${n}`:'不限'}</button>)}<p>仅筛选本榜已选套餐；查找其他档位请使用<a href="/recommend/">用量筛选</a>。</p></div>
<p id="rank-empty" class="empty" hidden>没有符合当前预算与搜索条件的候选。试试提高预算或清除搜索。</p>
<div class="compare-dock" id="rank-dock" hidden><div><strong id="rank-selected">已选 0 / 4</strong><div id="rank-chips" class="compare-chips"></div><span id="rank-feedback" aria-live="polite"></span></div><a class="button primary" id="rank-compare" href="/compare/">去比较 ↗</a></div>
<script>
const input=document.querySelector<HTMLInputElement>('#rank-search')!;const rows=Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-rank-brand]'));let budget=0;const selected=new Map<string,string>();const dock=document.querySelector<HTMLElement>('#rank-dock')!;
const toolbar=document.querySelector('.rank-toolbar')!;toolbar.after(document.querySelector('.rank-budget')!);
function filter(){let n=0;rows.forEach(row=>{row.hidden=!row.dataset.rankBrand!.includes(input.value.trim().toLowerCase())||(budget>0&&Number(row.dataset.price)>budget);if(!row.hidden)n++;});document.querySelector('#rank-count')!.textContent=`显示 ${n} 个参考候选；原表序位保留`;document.querySelector<HTMLElement>('#rank-empty')!.hidden=n>0;}
input.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach(button=>button.addEventListener('click',()=>{budget=Number(button.dataset.budget);document.querySelectorAll('[data-budget]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter();}));
function updateSelection(){dock.hidden=!selected.size;document.body.classList.toggle('has-compare-dock',selected.size>0);document.querySelector('#rank-selected')!.textContent=`已选 ${selected.size} / 4`;const chips=document.querySelector('#rank-chips')!;chips.replaceChildren();selected.forEach((name,slug)=>{const chip=document.createElement('button');chip.type='button';chip.textContent=`${name} ×`;chip.setAttribute('aria-label',`移除 ${name}`);chip.addEventListener('click',()=>{selected.delete(slug);updateSelection();});chips.append(chip);});document.querySelector<HTMLAnchorElement>('#rank-compare')!.href=`/compare/?brands=${Array.from(selected.keys()).join(',')}`;rows.forEach(row=>{const button=row.querySelector<HTMLButtonElement>('[data-select-brand]')!;button.setAttribute('aria-pressed',String(selected.has(row.dataset.slug!)));button.textContent=selected.has(row.dataset.slug!)?'已加入 ✓':'加入比较 +';button.disabled=selected.size>=4&&!selected.has(row.dataset.slug!);});}
rows.forEach(row=>{row.querySelector('[data-select-brand]')?.addEventListener('click',()=>{const slug=row.dataset.slug!;if(selected.has(slug))selected.delete(slug);else if(selected.size<4)selected.set(slug,row.querySelector('td:nth-child(2) a')!.textContent!);document.querySelector('#rank-feedback')!.textContent=selected.size===1?'再选一个品牌即可对比':selected.size===4?'最多选择四个品牌':'';updateSelection();});});
</script>


