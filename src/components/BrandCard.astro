---
import {traffic,type Airport} from '../data/airports';
const {airport:a}=Astro.props as {airport:Airport};const p=a.plans[0];
---
<article class="card brand-card"><div class="identity"><span class="monogram" aria-hidden="true">{a.name[0]}</span><div><h3>{a.name}</h3><span class="label">VPN · 官方资料</span></div></div><p>{a.description}</p><div class="price">{a.startingPrice} <small>{a.currency} 起 · {p.period==='free'?'免费方案':'月付'}</small></div><div class="facts"><div><span>套餐流量</span>{traffic(p)}</div><div><span>线路类型</span>尚未核实</div><div><span>适合人群</span>{a.suitableFor[0]}</div><div><span>资料核验</span>{a.lastVerified}</div></div><ul>{a.advantages.map(x=><li>{x}</li>)}</ul><p class="caution">注意：{a.disadvantages[0]}；未经本站实测。</p><a class="text-link" href={`/airport/${a.slug}/`}>查看资料 <span aria-hidden="true">↗</span></a></article>
