---
import ArticleCards from './ArticleCards.astro';import type {CollectionEntry} from 'astro:content';
const {entries,paginated=false}=Astro.props as {paginated?:boolean;entries:CollectionEntry<'articles'>[]};const labels:Record<string,string>={budget:'费用与流量',beginner:'新手入门',stable:'稳定与排错',ai:'AI 平台',streaming:'流媒体'};const tags=[...new Set(entries.flatMap(e=>e.data.tags))].filter(t=>labels[t]);
---
<section class="reading-path"><span class="eyebrow">START WITH A QUESTION</span><h2>先解决眼前的问题</h2><div><a href="/blog/selection-checklist/">第一次购买：核验清单 ↗</a><a href="/blog/budget-tradeoffs/">确定预算：金额与容量 ↗</a><a href="/guides/troubleshooting/">遇到问题：逐步排错 ↗</a><a href="/tools/traffic/">估算用量：流量计算器 ↗</a></div></section>
<div class="article-controls"><label for="article-search">{paginated?"搜索本页文章":"搜索本栏目文章"}<input id="article-search" class="search-input" type="search" placeholder="输入标题或关键词"/></label><label for="article-topic">阅读主题<select id="article-topic"><option value="">全部主题</option>{tags.map(t=><option value={t}>{labels[t]}</option>)}</select></label><span id="article-count" class="status" aria-live="polite">{entries.length} 篇文章</span></div>
<div class="grid-3" id="article-library">{entries.map(e=><div data-article-search={`${e.data.title} ${e.data.description}`.toLowerCase()} data-article-tags={e.data.tags.join(',')}><ArticleCards entries={[e]}/></div>)}</div><p id="article-empty" class="empty" hidden>没有匹配的文章，请尝试其他关键词或全部主题。</p>
<script>const search=document.querySelector<HTMLInputElement>('#article-search')!;const topic=document.querySelector<HTMLSelectElement>('#article-topic')!;function filter(){let n=0;document.querySelectorAll<HTMLElement>('[data-article-search]').forEach(card=>{card.hidden=!card.dataset.articleSearch!.includes(search.value.trim().toLowerCase())||(!!topic.value&&!card.dataset.articleTags!.split(',').includes(topic.value));if(!card.hidden)n++;});document.querySelector('#article-count')!.textContent=`显示 ${n} 篇文章`;document.querySelector<HTMLElement>('#article-empty')!.hidden=n>0;}search.addEventListener('input',filter);topic.addEventListener('change',filter);</script>
